// MARK: - Personal Pronouns
// 単数
"I" = "私";
"you" = "あなた";
"he" = "彼";
"she" = "彼女";
"it" = "それ";
"we" = "私たち";
// 複数
"you (plural)" = "あなたたち";
"they (male)" = "彼ら";
"they (female)" = "彼女たち";
"they (neuter)" = "それら";
